# Copy this file to .env.local (git-ignored) and fill in real values.
# Never commit .env.local or any file containing real secrets.

# ── App ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Supabase ─────────────────────────────────────────────────────────────
# Project Settings → API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses Row-Level Security — never expose to the browser,
# never prefix with NEXT_PUBLIC_. Used for admin/service tasks only.
SUPABASE_SERVICE_ROLE_KEY=

# ── Anthropic (AI lesson generation) ────────────────────────────────────
# Server-only. Used from API routes only — never expose to the browser,
# never prefix with NEXT_PUBLIC_. https://console.anthropic.com/
ANTHROPIC_API_KEY=

# ── Stripe ───────────────────────────────────────────────────────────────
# Publishable key is safe for the browser; secret and webhook keys are
# server-only and must never be prefixed with NEXT_PUBLIC_.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
# From the Stripe CLI (`stripe listen`) in dev, or the webhook endpoint's
# signing secret in the Stripe dashboard in production.
STRIPE_WEBHOOK_SECRET=
# One Price object per (tier x interval) — 3 tiers (see the `subscriptions`
# table: full_year / one_course / two_course) x monthly/annual = 6 prices,
# created in the Stripe dashboard under Product catalog.
STRIPE_PRICE_ID_FULL_YEAR_MONTHLY=
STRIPE_PRICE_ID_FULL_YEAR_ANNUAL=
STRIPE_PRICE_ID_ONE_COURSE_MONTHLY=
STRIPE_PRICE_ID_ONE_COURSE_ANNUAL=
STRIPE_PRICE_ID_TWO_COURSE_MONTHLY=
STRIPE_PRICE_ID_TWO_COURSE_ANNUAL=
