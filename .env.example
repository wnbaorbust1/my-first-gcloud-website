# Copy this file to .env and fill in real values for local development.
# Never commit .env — it is gitignored.

# Postgres connection string.
# Local dev example: postgresql://blueprint:blueprint_dev_pw@localhost:5432/blueprint_dev?schema=public
# Production (Cloud SQL) example: postgresql://USER:PASSWORD@HOST:5432/blueprint?schema=public&sslmode=require
DATABASE_URL=""

# NextAuth.js
# Base URL of the deployed app (http://localhost:3000 for local dev).
NEXTAUTH_URL="http://localhost:3000"
# Random secret used to sign session tokens. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""

# Google OAuth (optional). Leave blank to disable Google sign-in — the app
# is architected to support it, but it is not required for email/password auth.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Blueprint AI (optional). Leave blank to disable real AI responses — the
# full chat/history/context/Builder-integration UI still works, but every
# response explains that no AI provider key is configured yet instead of
# calling out to Anthropic. Get a key at https://console.anthropic.com/.
ANTHROPIC_API_KEY=""
# Defaults to "claude-sonnet-4-5" if unset.
ANTHROPIC_MODEL=""

# Stripe (optional). Leave STRIPE_SECRET_KEY blank to disable real
# checkout/portal/cancel/reactivate — the complimentary trial, access
# gating, and Billing page all work without it; billing actions instead
# explain that billing isn't connected yet. STRIPE_WEBHOOK_SECRET is
# still required for the webhook route to accept anything (it's how
# incoming events are verified as genuinely from Stripe) — get both from
# https://dashboard.stripe.com/apikeys and
# https://dashboard.stripe.com/webhooks.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Recurring Price ids for the $9.99/month and $100/year plans, created in
# the Stripe Dashboard (Products).
STRIPE_PRICE_ID_MONTHLY=""
STRIPE_PRICE_ID_ANNUAL=""
